# Normalise line endings in the repository, regardless of the contributor's OS.
* text=auto eol=lf

*.sh            text eol=lf
*.py            text eol=lf
Makefile        text eol=lf
*.md            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# Binary fixtures and specimens.
*.jpg           binary
*.jpeg          binary
*.png           binary
*.tif           binary
*.tiff          binary
*.heic          binary
*.avif          binary
*.bin           binary
*.o             binary

# Keep build output out of "Download ZIP" and the release archives. Everything
# else, .github/ and the dotfiles included, IS part of the source snapshot: a
# tarball that silently omits the workflows and templates is not the project.
/build/          export-ignore
/build-*/        export-ignore
/tests/fixtures/ export-ignore

# Diffusion and language stats: stop the web UI from calling this project "C".
tests/fixtures/* linguist-generated
/build/*         linguist-vendored

# Make diffs easier to read.
*.md            diff=markdown
